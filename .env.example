# Copy this file to .env and fill in real values.
# .env is gitignored and never leaves this machine.

# --- Zabbix ---
# Local Docker sandbox: http://localhost:8080/api_jsonrpc.php
# Lab: point at your Zabbix server's API endpoint
ZABBIX_API_URL=http://localhost:8080/api_jsonrpc.php
# Create in Zabbix UI: User settings -> API tokens
ZABBIX_API_TOKEN=your-api-token-here

# --- LLM (Project 1: alert enrichment) ---
ANTHROPIC_API_KEY=your-key-here

# --- Warehouse (Project 3) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=TELEMETRY
SNOWFLAKE_SCHEMA=BRONZE
