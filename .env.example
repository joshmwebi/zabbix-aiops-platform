# Copy this file to .env and fill in real values.
# .env is gitignored and never leaves this machine.

# --- Zabbix ---
# Local Docker sandbox: http://localhost:8080/api_jsonrpc.php
# Lab: the frontend URL with api_jsonrpc.php appended
ZABBIX_API_URL=http://localhost:8080/api_jsonrpc.php
# Zabbix UI -> Users -> API tokens. Use a read-only service account.
ZABBIX_API_TOKEN=your-api-token-here

# --- Alert enrichment ---
# API key. Not needed if you only run with --dry-run.
ANTHROPIC_API_KEY=your-key-here
# Optional: point at an internal/enterprise LLM gateway instead of the public
# API, so telemetry stays on approved infrastructure. Leave blank for the
# public endpoint (console.anthropic.com).
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
# Response ceiling. Too low truncates the JSON mid-object and the triage
# degrades to a fallback.
ANTHROPIC_MAX_TOKENS=1500
# Lowest Zabbix severity to enrich: 0 none .. 2 warning .. 5 disaster
MIN_SEVERITY=2
# Hosts sharing one trigger before it is treated as a fleet-wide incident
FLEET_INCIDENT_THRESHOLD=3
# Seconds between polls in continuous mode
POLL_INTERVAL_SECONDS=120

# --- Delivery (both optional; unset = sink disabled) ---
# Teams Workflows webhook endpoint for triage cards
TEAMS_WEBHOOK_URL=
# Token from an acknowledge-capable Zabbix account, used ONLY to attach
# triage to problems. Keep ZABBIX_API_TOKEN read-only.
ZABBIX_WRITE_TOKEN=

# --- Warehouse ---
# Which backend the pipeline loads into: postgres | snowflake
WAREHOUSE_TYPE=postgres

# PostgreSQL (used when WAREHOUSE_TYPE=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=telemetry
PG_USER=
PG_PASSWORD=

# Snowflake (used when WAREHOUSE_TYPE=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# Auth: use externalbrowser for SSO (interactive), or supply a password or
# key pair for unattended scheduled runs.
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
