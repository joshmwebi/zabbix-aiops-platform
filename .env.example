# Copy this file to .env and fill in real values.
# .env is gitignored and never leaves this machine.

# --- Zabbix ---
# Local Docker sandbox: http://localhost:8080/api_jsonrpc.php
# Lab: the frontend URL with api_jsonrpc.php appended
ZABBIX_API_URL=http://localhost:8080/api_jsonrpc.php
# Zabbix UI -> Users -> API tokens. Use a read-only service account.
ZABBIX_API_TOKEN=your-api-token-here

# --- Alert enrichment ---
# console.anthropic.com. Not needed if you only run with --dry-run.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Lowest Zabbix severity to enrich: 0 none .. 2 warning .. 5 disaster
MIN_SEVERITY=2
# Hosts sharing one trigger before it is treated as a fleet-wide incident
FLEET_INCIDENT_THRESHOLD=3
# Seconds between polls in continuous mode
POLL_INTERVAL_SECONDS=120

# --- Warehouse (Project 3, not yet used) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=TELEMETRY
SNOWFLAKE_SCHEMA=BRONZE
